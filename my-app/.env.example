DATABASE_URL=
# At least 32 random characters; setup-auth.mjs generates this locally if missing.
AUTH_SECRET=
# Exact browser origin, no trailing slash. Use HTTPS in production.
AUTH_ORIGIN=http://localhost:3000

# Required on Vercel, shared only between Node and Python functions.
INQUIRY_CLASSIFIER_SECRET=
# Optional server-side override. Defaults to the current Vercel deployment;
# local Next.js uses http://127.0.0.1:8001/api/classify_inquiry.
# INQUIRY_CLASSIFIER_URL=http://127.0.0.1:8001/api/classify_inquiry
# For Vercel Deployment Protection, enable its automation bypass setting.
# VERCEL_AUTOMATION_BYPASS_SECRET is supplied by Vercel, not committed here.
